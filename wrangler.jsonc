{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "applywell",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "applywell.hugojava.dev",
      "custom_domain": true
    }
  ]
}
